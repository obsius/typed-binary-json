{
	"name": "typed-binary-json",
	"version": "1.22.0",
	"description": "A TBJSON parser and serializer.",
	"homepage": "https://github.com/obsius/typed-binary-json",
	"author": "Jeff Seaman <mr.jeffrey.seaman@gmail.com> (obsius.net)",
	"license": "MIT",
	"main": "lib/index.js",
	"browser": "lib/browser.mjs",
	"files": [
		"/lib"
	],
	"engines": {
		"node": ">=14.6.0"
	},
	"scripts": {
		"prepare": "rollup --bundleConfigAsCjs -c",
		"start": "nodemon --inspect dev.js --exec babel-node",
		"benchmarks": "babel-node --expose-gc test --benchmarks",
		"test": "babel-node test"
	},
	"devDependencies": {
		"@babel/core": "^7.26.0",
		"@babel/node": "^7.26.0",
		"@babel/preset-env": "^7.26.0",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-inject": "^5.0.5",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"buffer": "^6.0.3",
		"nodemon": "^3.1.7",
		"rollup": "^4.28.0"
	},
	"babel": {
		"presets": [
			[
				"@babel/preset-env",
				{
					"targets": {
						"node": "current"
					}
				}
			]
		]
	},
	"keywords": [
		"json",
		"binary",
		"typed",
		"parser",
		"serializer"
	]
}
